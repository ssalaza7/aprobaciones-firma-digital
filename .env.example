# Copie a .env y ajuste. Todos tienen valor por defecto: sin .env el backend
# corre en memoria y no necesita AWS.

# --- Backend ---
PUERTO=4000
PERSISTENCIA=memoria          # memoria | dynamo
ALMACEN=archivos              # archivos | s3
TABLA_DYNAMO=aprobaciones
# DYNAMO_ENDPOINT=http://localhost:8000   # solo con DynamoDB Local
# BUCKET_EVIDENCIAS=aprobaciones-evidencias-dev
DIRECTORIO_EVIDENCIAS=.datos/evidencias
URL_BASE_FRONTEND=http://localhost:3000
ORIGENES_PERMITIDOS=*
EXPONER_OTP=true              # false en cualquier entorno real

# --- Frontend (se leen al compilar) ---
API_URL=http://localhost:4000
URL_MF_SOLICITANTE=http://localhost:3001
URL_MF_APROBADOR=http://localhost:3002
