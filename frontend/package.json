{
  "name": "aprobaciones-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Microfrontends del flujo de aprobaciones (Module Federation con webpack 5)",
  "workspaces": [
    "packages/shared",
    "packages/host",
    "packages/mf-solicitante",
    "packages/mf-aprobador"
  ],
  "scripts": {
    "dev": "concurrently -n solicitante,aprobador,host -c blue,magenta,green \"npm run dev -w @aprobaciones/mf-solicitante\" \"npm run dev -w @aprobaciones/mf-aprobador\" \"npm run dev -w @aprobaciones/host\"",
    "build": "npm run build -w @aprobaciones/mf-solicitante && npm run build -w @aprobaciones/mf-aprobador && npm run build -w @aprobaciones/host",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cobertura": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.0.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.6.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
