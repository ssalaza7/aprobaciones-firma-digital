{
  "name": "aprobaciones-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Flujo de aprobaciones con firma digital concatenada - backend serverless (arquitectura hexagonal)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "tabla:local": "ts-node-dev --transpile-only scripts/crear-tabla-local.ts",
    "dev:dynamo": "PERSISTENCIA=dynamo DYNAMO_ENDPOINT=http://localhost:8000 ALMACEN=archivos ts-node-dev --respawn --transpile-only src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "express": "^4.21.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.0",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
